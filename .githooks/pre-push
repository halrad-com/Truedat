#!/bin/sh
# Run the data gate over every commit this push would publish. See data-gate.sh.
#
# This is the check that matters most for a public repository: a data commit made before the gate
# existed, or with --no-verify, only becomes public when it is pushed, and a push sends every
# unpushed commit on the branch, not just the latest one.

here=$(dirname "$0")
zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a remote ref publishes nothing.
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" = "$zero" ]; then
    # A new branch: everything not already on any remote.
    sh "$here/data-gate.sh" commits "$local_sha" --not --remotes || status=1
  else
    sh "$here/data-gate.sh" commits "$remote_sha..$local_sha" || status=1
  fi
done

exit $status
