<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>truedat</AssemblyName>
  </PropertyGroup>

  <!-- ILRepack: Merge System.Text.Json + TagLibSharp + Microsoft.ML.OnnxRuntime
       (managed) + BCL polyfills into single exe. Native ORT/DirectML DLLs ship as
       siblings (see ILRepack.targets for filter pattern). -->
  <PropertyGroup>
    <ILRepackInternalize>true</ILRepackInternalize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" PrivateAssets="all" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" PrivateAssets="all" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.34.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\stub.mp3" />
  </ItemGroup>

</Project>
