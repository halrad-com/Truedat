<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>truedat</AssemblyName>
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Copyright>Copyright (c) 2026 Halrad LLC</Copyright>
  </PropertyGroup>

  <!-- Stamp git branch + COMMIT into a generated source file so VersionInfo.Display can
       read them at runtime. Pattern mirrors MBXHub.Core's GenerateBranchInfo target.
       ContinueOnError keeps a missing-git / detached-HEAD build working (branch falls
       back to "unknown" and VersionInfo treats that the same as main — branch omitted).

       This used to stamp a BUILD EPOCH (UtcNow). That was changed 2026-07-25 because a
       build clock answers the wrong question and answered it unreliably: the dist binary
       reported the same epoch across two builds with different code in them, so the stamp
       could not be trusted to tell you what a binary contained — the only reliable check
       was counting self-test assertions. A commit stamp answers the question that actually
       matters ("what source is in this exe?") and cannot go stale, because it is read from
       git rather than from the clock.

       The +dirty suffix is load-bearing: a build from a modified tree is NOT identified by
       its commit, and silently labelling one with a clean SHA is how a "verified" binary
       ends up containing something nobody reviewed. -->
  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <Exec Command="git rev-parse --abbrev-ref HEAD"
          ConsoleToMSBuild="true"
          ContinueOnError="true"
          IgnoreExitCode="true"
          WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitBranchRaw" />
    </Exec>
    <Exec Command="git rev-parse --short=7 HEAD"
          ConsoleToMSBuild="true"
          ContinueOnError="true"
          IgnoreExitCode="true"
          WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommitRaw" />
    </Exec>
    <Exec Command="git status --porcelain --untracked-files=no"
          ConsoleToMSBuild="true"
          ContinueOnError="true"
          IgnoreExitCode="true"
          WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitDirtyRaw" />
    </Exec>
    <PropertyGroup>
      <_GitBranch Condition="'$(_GitBranchRaw)' != ''">$(_GitBranchRaw)</_GitBranch>
      <_GitBranch Condition="'$(_GitBranchRaw)' == ''">unknown</_GitBranch>
      <_GitCommit Condition="'$(_GitCommitRaw)' != ''">$(_GitCommitRaw)</_GitCommit>
      <_GitCommit Condition="'$(_GitCommitRaw)' == ''">unknown</_GitCommit>
      <_GitDirty Condition="'$(_GitDirtyRaw)' != ''">true</_GitDirty>
      <_GitDirty Condition="'$(_GitDirtyRaw)' == ''">false</_GitDirty>
      <_BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</_BuildInfoFile>
      <_BuildInfoContent>// &lt;auto-generated/&gt; — written by Truedat.csproj GenerateBuildInfo target.
namespace Truedat { internal static class BuildInfo { internal const string Branch = "$(_GitBranch)"%3B internal const string Commit = "$(_GitCommit)"%3B internal const bool Dirty = $(_GitDirty)%3B } }</_BuildInfoContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(_BuildInfoFile)"
                      Lines="$(_BuildInfoContent)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_BuildInfoFile)" Exclude="@(Compile)" />
    </ItemGroup>
  </Target>

  <!-- ILRepack: Merge System.Text.Json + TagLibSharp into the single exe. -->
  <PropertyGroup>
    <ILRepackInternalize>true</ILRepackInternalize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" PrivateAssets="all" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" PrivateAssets="all" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.34.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\stub.mp3" />
  </ItemGroup>

</Project>
