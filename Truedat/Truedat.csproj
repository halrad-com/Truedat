<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>truedat</AssemblyName>
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Copyright>Copyright (c) 2026 Halrad LLC</Copyright>
  </PropertyGroup>

  <!-- Stamp git branch + build epoch into a generated source file so VersionInfo.Display
       can read them at runtime. Pattern mirrors MBXHub.Core's GenerateBranchInfo target.
       ContinueOnError keeps a missing-git / detached-HEAD build working (branch falls
       back to "unknown" and VersionInfo treats that the same as main — branch omitted). -->
  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <Exec Command="git rev-parse --abbrev-ref HEAD"
          ConsoleToMSBuild="true"
          ContinueOnError="true"
          IgnoreExitCode="true"
          WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitBranchRaw" />
    </Exec>
    <PropertyGroup>
      <_GitBranch Condition="'$(_GitBranchRaw)' != ''">$(_GitBranchRaw)</_GitBranch>
      <_GitBranch Condition="'$(_GitBranchRaw)' == ''">unknown</_GitBranch>
      <_BuildEpoch>$([System.DateTimeOffset]::UtcNow.ToUnixTimeSeconds())</_BuildEpoch>
      <_BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</_BuildInfoFile>
      <_BuildInfoContent>// &lt;auto-generated/&gt; — written by Truedat.csproj GenerateBuildInfo target.
namespace Truedat { internal static class BuildInfo { internal const string Branch = "$(_GitBranch)"%3B internal const long Epoch = $(_BuildEpoch)%3B } }</_BuildInfoContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(_BuildInfoFile)"
                      Lines="$(_BuildInfoContent)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_BuildInfoFile)" Exclude="@(Compile)" />
    </ItemGroup>
  </Target>

  <!-- ILRepack: Merge System.Text.Json + TagLibSharp + Microsoft.ML.OnnxRuntime
       (managed) + BCL polyfills into single exe. Native ORT/DirectML DLLs ship as
       siblings (see ILRepack.targets for filter pattern). -->
  <PropertyGroup>
    <ILRepackInternalize>true</ILRepackInternalize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" PrivateAssets="all" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" PrivateAssets="all" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.34.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\stub.mp3" />
  </ItemGroup>

</Project>
