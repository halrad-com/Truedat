.claude/
_starclaudethere.cmd
bin/
obj/

# External dependencies — not built by this project (see DEPS.md for provenance)
dist/truedat/ffmpeg.exe
dist/truedat/ffprobe.exe
dist/truedat/ffplay.exe

# Release bundle — too large for GitHub (>100MB), ship via Releases instead
dist/truedat/truedat.zip

# Synthetic library data (large downloads)
data/

# Internal docs — never published
_docs/
docs/

# Scrub helper scripts (local only)
.scrub-*.ps1

# Python cache
src/__pycache__/
vam-tools/__pycache__/
smfm-tools/__pycache__/

# Trainer venv — one-time-per-machine, see vam-tools/README.md
vam-tools/.venv/

# Brainstorm companion scratch (visual mockups, previews)
.superpowers/

# essentia-build local build output — the 3rd-party deps ship (sanitized) as
# essentia-build/3rdparty-x64-deps.tar.gz. A local build/extraction repopulates
# 3rdparty/include + lib, whose .pc/.la metadata bake in the real build path
# (leaks the username), so the loose copies must never be tracked. Build recipes
# (build_*.sh) and the sanitized archive stay tracked.
essentia-build/3rdparty/include/
essentia-build/3rdparty/lib/
# build logs — transient, can carry local paths / private info
essentia-build/**/*.log
