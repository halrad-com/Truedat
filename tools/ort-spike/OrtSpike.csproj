<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>ortspike</AssemblyName>
    <RootNamespace>OrtSpike</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <!-- For Step 6 of the spike: produce a merged `ilrepacked-ortspike.exe` next
         to the unmerged `ortspike.exe`. ILRepack.targets in this directory
         overrides the default merge behavior to filter out native DLLs. -->
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.34.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- For Step 5 (NPU enumeration via DXGI) -->
    <Reference Include="System.Runtime.InteropServices" />
  </ItemGroup>

</Project>
