<Project>
  <!--
    ILRepack target for the NPU MCDM spike. Same shape as tools/ort-spike/
    — produces an ilrepacked-ortspike-npu.exe alongside the unmerged
    ortspike-npu.exe so we can verify the merged form still runs. Native
    ORT/DirectML DLLs stay as siblings (native binaries can't merge into
    a managed exe).

    Target name must be DISTINCT from "ILRepack" because the
    ILRepack.Lib.MSBuild.Task package imports a (guarded, no-op) target
    of that name *after* this file is processed; MSBuild last-definition-wins
    would otherwise silently skip our merge. Same footgun documented by
    the S2.1 sibling. Use `ILRepackSpikeNpu` and `AfterTargets="Build"`.
  -->

  <Target Name="ILRepackSpikeNpu" AfterTargets="Build" Condition="$(Configuration.Contains('Release'))">
    <ItemGroup>
      <SpikeNpuMergeInputs Include="$(OutputPath)$(TargetName)$(TargetExt)" />
      <SpikeNpuMergeInputs Include="$(OutputPath)Microsoft.ML.OnnxRuntime.dll" Condition="Exists('$(OutputPath)Microsoft.ML.OnnxRuntime.dll')" />
      <SpikeNpuMergeInputs Include="$(OutputPath)System.Buffers.dll" Condition="Exists('$(OutputPath)System.Buffers.dll')" />
      <SpikeNpuMergeInputs Include="$(OutputPath)System.Memory.dll" Condition="Exists('$(OutputPath)System.Memory.dll')" />
      <SpikeNpuMergeInputs Include="$(OutputPath)System.Numerics.Vectors.dll" Condition="Exists('$(OutputPath)System.Numerics.Vectors.dll')" />
      <SpikeNpuMergeInputs Include="$(OutputPath)System.Runtime.CompilerServices.Unsafe.dll" Condition="Exists('$(OutputPath)System.Runtime.CompilerServices.Unsafe.dll')" />
    </ItemGroup>

    <Message Importance="high" Text="ILRepackSpikeNpu: merging @(SpikeNpuMergeInputs->Count()) assemblies into ilrepacked-ortspike-npu.exe" />
    <Message Importance="normal" Text="  input: %(SpikeNpuMergeInputs.Identity)" />

    <ILRepack
        Parallel="true"
        DebugInfo="true"
        Internalize="true"
        AllowDuplicateResources="false"
        InputAssemblies="@(SpikeNpuMergeInputs)"
        TargetKind="Exe"
        OutputFile="$(OutputPath)ilrepacked-ortspike-npu.exe"
    />

    <Message Importance="high" Text="ILRepackSpikeNpu: produced $(OutputPath)ilrepacked-ortspike-npu.exe (native DLLs stay as siblings)" />
  </Target>

</Project>
